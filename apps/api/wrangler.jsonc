// Local development and tests. Production config is generated at deploy time
// by scripts/prod-config.mjs (adds the real D1 id, static assets, custom domain).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "interview-tower",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "interview-tower",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "SITE_URL": "http://localhost:8788"
  }
}
